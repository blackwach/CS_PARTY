# Public bind for allocator API
ALLOCATOR_BIND_IP=0.0.0.0
ALLOCATOR_PORT=8090

# Host/IP that CS2 clients must use in connect command
CS2_PUBLIC_HOST=YOUR_X86_HOST_OR_DOMAIN

# Dedicated server image and runtime options
CS2_IMAGE=joedwards32/cs2:latest
CS2_PORT_RANGE_START=27100
CS2_PORT_RANGE_END=27200
CS2_REQUIRE_X86=true
CS2_SERVER_PASSWORD=
CS2_HOST_BIND_IP=0.0.0.0
CS2_DEFAULT_MAP=de_dust2
CS2_DEFAULT_GAME_TYPE=0
CS2_DEFAULT_GAME_MODE=1
