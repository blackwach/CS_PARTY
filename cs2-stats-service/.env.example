PORT=3100

# Optional API protection for /players and /bot/reconnect
CS2_STATS_API_TOKEN=

# Steam bot credentials
CS2_STATS_STEAM_USERNAME=your_steam_login
CS2_STATS_STEAM_PASSWORD=your_steam_password
CS2_STATS_STEAM_2FA_SECRET=
CS2_STATS_STEAM_DATA_DIR=./.steam-data

# Optional auto-fill of Steam Guard code from email (IMAP)
CS2_STATS_STEAM_EMAIL_GUARD_ENABLED=false
CS2_STATS_STEAM_EMAIL_IMAP_HOST=imap.yandex.ru
CS2_STATS_STEAM_EMAIL_IMAP_PORT=993
CS2_STATS_STEAM_EMAIL_IMAP_INBOX=INBOX
CS2_STATS_STEAM_EMAIL_IMAP_USER=
CS2_STATS_STEAM_EMAIL_IMAP_PASSWORD=
CS2_STATS_STEAM_EMAIL_FROM_FILTER=noreply@steampowered.com
CS2_STATS_STEAM_EMAIL_SUBJECT_FILTER=Steam Guard
CS2_STATS_STEAM_EMAIL_IMAP_TIMEOUT_MS=90000
CS2_STATS_STEAM_EMAIL_IMAP_POLL_INTERVAL_MS=5000
# Пауза перед первым опросом почты (письмо приходит с задержкой), мс
CS2_STATS_STEAM_EMAIL_INITIAL_WAIT_MS=18000
# Код брать только из писем не старше N мс (5 мин по умолчанию)
CS2_STATS_STEAM_EMAIL_MAX_AGE_MS=300000
CS2_STATS_STEAM_EMAIL_IMAP_MAX_MESSAGES=8
# Размер тела письма при FETCH (по умолчанию 16384). После успешного чтения кода письмо помечается прочитанным.
CS2_STATS_STEAM_EMAIL_IMAP_FETCH_BODY_MAX=16384

# Runtime tuning
CS2_STATS_CACHE_TTL_MS=60000
CS2_STATS_REQUEST_TIMEOUT_MS=15000
CS2_STATS_MATCH_HISTORY_REQUEST_TIMEOUT_MS=12000
CS2_STATS_MATCH_HISTORY_MAX_SHARE_CODES_PER_SYNC=5
CS2_STATS_MATCH_HISTORY_TIME_BUDGET_MS=10000
CS2_STATS_RECONNECT_DELAY_MS=15000
# При AccountLoginDeniedThrottle следующая попытка через N мс (по умолчанию 5 мин)
CS2_STATS_RECONNECT_DELAY_THROTTLE_MS=300000
