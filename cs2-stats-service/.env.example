PORT=3100

# Optional API protection for /players and /bot/reconnect
CS2_STATS_API_TOKEN=

# Steam bot credentials
CS2_STATS_STEAM_USERNAME=your_steam_login
CS2_STATS_STEAM_PASSWORD=your_steam_password
CS2_STATS_STEAM_2FA_SECRET=

# Runtime tuning
CS2_STATS_CACHE_TTL_MS=60000
CS2_STATS_REQUEST_TIMEOUT_MS=15000
CS2_STATS_RECONNECT_DELAY_MS=15000
