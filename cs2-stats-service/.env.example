# Порт HTTP API (по умолчанию 3100)
PORT=3100

# Steam-аккаунт для входа в Game Coordinator (CS2).
# Этот аккаунт должен быть в друзьях у игроков, чью статистику запрашиваем.
STEAM_USERNAME=your_steam_login
STEAM_PASSWORD=your_steam_password

# Если включён Steam Guard Mobile Authenticator — укажите shared secret
# (получить можно через восстановление: https://github.com/SteamTimeIdler/stid/wiki/Getting-your-Shared-Secret)
STEAM_2FA_SECRET=
