# Django
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=False
# Укажите все хосты, по которым заходят на API (в т.ч. домен за nginx/прокси)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,cs2party.duckdns.org
FRONTEND_URL=https://cs2party.duckdns.org
RUN_CREATE_SUPERUSER=0
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Database
DATABASE_URL=postgresql://cs_party:cs_party@db:5432/cs_party

# Email (SMTP) — Яндекс
# Не подставляйте обычный пароль от почты: при включённых «Пароли приложений» нужен пароль приложения.
# Как получить: id.yandex.ru → Безопасность → Пароли приложений → Создать (тип «Почта»). Подробно: backend/docs/YANDEX_SMTP.md
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_HOST_USER=ваш-логин@yandex.ru
EMAIL_HOST_PASSWORD=пароль-приложения-из-яндекс-id
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CS Party <ваш-логин@yandex.ru>

# Telegram
TELEGRAM_BOT_TOKEN=

# External CS2 stats provider
# Endpoint format: GET {CS2_STATS_API_URL}/players/{steam_id}
# Expected response: { rank, wins, losses, matches[] }
# If you run bundled cs2-stats-service in docker-compose, use:
# CS2_STATS_API_URL=http://cs2_stats_service:3100
# If backend runs outside docker-compose, use:
# CS2_STATS_API_URL=http://<server-host-or-ip>:3100
# You can also leave it empty: backend will use limited public-profile mode.
CS2_STATS_API_URL=
CS2_STATS_API_TOKEN=
# Credentials for bundled cs2-stats-service (stored in backend/.env and reused by compose service):
CS2_STATS_STEAM_USERNAME=
CS2_STATS_STEAM_PASSWORD=
CS2_STATS_STEAM_2FA_SECRET=
# Required for full history sync by match token/share code chain:
# https://steamcommunity.com/dev/apikey
CS2_STATS_STEAM_WEB_API_KEY=

# Optional CS2 room server provisioning
# Option A (external allocator API): POST {CS2_SERVER_API_URL}/servers -> {host, port, password?, steam_connect_url?}
# For host-auto mode (host starts CS2 locally from room), keep CS2_SERVER_API_URL empty.
CS2_SERVER_API_URL=
CS2_SERVER_API_TOKEN=
# Option B (single static server)
CS2_SERVER_HOST=
CS2_SERVER_PORT=0
CS2_SERVER_PASSWORD=

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1

# Celery / Redis
REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/1
