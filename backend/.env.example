# Django
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost

# Database
DATABASE_URL=postgresql://cs_party:cs_party@db:5432/cs_party

# Email (SMTP) — под настройки «Почтовые программы» Яндекса
# У вас включено: доступ по IMAP + авторизация «Пароли приложений и OAuth-токены».
# Для отправки писем используйте тот же пароль приложения (id.yandex.ru → Безопасность → Пароли приложений → Почта).
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_HOST_USER=your-login@yandex.ru
EMAIL_HOST_PASSWORD=пароль-приложения
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CS Party <your-login@yandex.ru>

# Telegram
TELEGRAM_BOT_TOKEN=

# External CS2 stats provider
# Endpoint format: GET {CS2_STATS_API_URL}/players/{steam_id}
# Expected response: { rank, wins, losses, matches[] }
CS2_STATS_API_URL=
CS2_STATS_API_TOKEN=

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Celery / Redis
REDIS_URL=redis://redis:6379/0
